{
  "title": "Async Debug",
  "uid": "async-debug",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Activity Execution Latency",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(temporal_activity_execution_latency_sum[30s]) / rate(temporal_activity_execution_latency_count[30s])",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Workflow Task Schedule-To-Start Latency",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(temporal_workflow_task_schedule_to_start_latency_sum[30s]) / rate(temporal_workflow_task_schedule_to_start_latency_count[30s])",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Workflow Task Execution Latency",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(temporal_workflow_task_execution_latency_sum[30s]) / rate(temporal_workflow_task_execution_latency_count[30s])",
          "legendFormat": "avg"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Activity And Workflow Task Failures",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(temporal_activity_execution_failed[1m])",
          "legendFormat": "activity failed"
        },
        {
          "refId": "B",
          "expr": "increase(temporal_workflow_task_execution_failed[1m])",
          "legendFormat": "workflow task failed"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Task Slots Used By Worker Type",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (worker_type) (temporal_worker_task_slots_used)",
          "legendFormat": "{{worker_type}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Task Queue Backlog",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "approximate_backlog_count",
          "legendFormat": "backlog"
        }
      ]
    }
  ]
}
